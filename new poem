<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Poetry Speaks Louder</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background:
        radial-gradient(circle at 20% 20%, rgba(111, 48, 170, 0.18), transparent 30%),
        radial-gradient(circle at 80% 70%, rgba(75, 24, 116, 0.2), transparent 35%),
        linear-gradient(135deg, #08030d, #12051d 45%, #09030e);
    color: #eee5f5;
    font-family: 'Cormorant Garamond', serif;
    overflow-x: hidden;
}

/* =========================
   BACKGROUND STARS
========================= */

.stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
}

.star {
    position: absolute;
    width: 2px;
    height: 2px;
    background: rgba(255,255,255,0.7);
    border-radius: 50%;
    animation: twinkle 4s infinite ease-in-out;
}

@keyframes twinkle {
    0%,100% { opacity: .2; transform: scale(.7); }
    50% { opacity: 1; transform: scale(1.5); }
}

/* =========================
   NAVIGATION
========================= */

nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 25px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    background: linear-gradient(to bottom, rgba(5,1,9,.8), transparent);
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    letter-spacing: 3px;
    color: #f3e9fa;
}

.logo span {
    color: #a86bd4;
}

nav a {
    color: #d9c9e2;
    text-decoration: none;
    font-family: 'Montserrat', sans-serif;
    font-size: .72rem;
    letter-spacing: 2px;
    margin-left: 30px;
    transition: .3s;
}

nav a:hover {
    color: #c995eb;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 100px 20px;
}

.hero-content {
    max-width: 950px;
    animation: entrance 2s ease forwards;
}

@keyframes entrance {
    from {
        opacity: 0;
        transform: translateY(35px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.small-title {
    font-family: 'Montserrat', sans-serif;
    font-size: .7rem;
    letter-spacing: 6px;
    color: #a875c9;
    margin-bottom: 25px;
    text-transform: uppercase;
}

.hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -5px;
}

.hero h1 em {
    color: #b879e2;
    font-weight: 400;
}

.hero-description {
    max-width: 650px;
    margin: 35px auto;
    color: #b9a8c2;
    font-size: 1.35rem;
    line-height: 1.7;
}

.enter {
    display: inline-block;
    margin-top: 25px;
    padding: 14px 35px;
    border: 1px solid rgba(184,121,226,.5);
    color: #e7d7ef;
    text-decoration: none;
    font-family: 'Montserrat', sans-serif;
    font-size: .68rem;
    letter-spacing: 3px;
    transition: .4s;
}

.enter:hover {
    background: #8b45b3;
    border-color: #8b45b3;
    box-shadow: 0 0 30px rgba(150,70,200,.3);
}

/* =========================
   POETRY SECTION
========================= */

.poetry-world {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    padding: 120px 0;
    overflow: hidden;
}

.section-heading {
    text-align: center;
    margin-bottom: 70px;
}

.section-heading h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 400;
}

.section-heading p {
    color: #8f7c9a;
    font-family: 'Montserrat', sans-serif;
    font-size: .65rem;
    letter-spacing: 4px;
    margin-top: 15px;
}

/* SLIDER */

.poem-slider {
    width: 100%;
    overflow: hidden;
    position: relative;
}

.poem-track {
    display: flex;
    width: max-content;
    animation: slidePoems 55s linear infinite;
}

.poem-track:hover {
    animation-play-state: paused;
}

@keyframes slidePoems {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-50%);
    }
}

.poem {
    width: 440px;
    min-height: 510px;
    margin: 0 15px;
    padding: 55px 45px;
    position: relative;

    background:
        linear-gradient(145deg,
        rgba(54,22,73,.55),
        rgba(19,7,29,.85));

    border: 1px solid rgba(174,115,205,.18);

    box-shadow:
        0 30px 80px rgba(0,0,0,.4),
        inset 0 0 80px rgba(107,45,140,.06);

    transition: .5s;
}

.poem:hover {
    transform: translateY(-15px);
    border-color: rgba(190,130,224,.5);
    box-shadow:
        0 35px 90px rgba(0,0,0,.5),
        0 0 40px rgba(127,53,164,.15);
}

.poem-number {
    font-family: 'Montserrat', sans-serif;
    font-size: .65rem;
    letter-spacing: 3px;
    color: #8c5ca7;
}

.poem h3 {
    font-family: 'Playfair Display', serif;
    font-size: 2.1rem;
    font-weight: 400;
    margin: 30px 0;
    color: #f0e3f5;
}

.poem p {
    color: #c0aec8;
    font-size: 1.3rem;
    line-height: 1.65;
}

.poem p em {
    color: #d197ed;
}

.author {
    position: absolute;
    bottom: 35px;
    left: 45px;
    font-family: 'Montserrat', sans-serif;
    font-size: .58rem;
    letter-spacing: 3px;
    color: #755982;
}

/* =========================
   QUOTE
========================= */

.quote-section {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 20px;
    position: relative;
    z-index: 2;
    text-align: center;
}

.quote {
    max-width: 900px;
}

.quote-mark {
    font-family: 'Playfair Display', serif;
    font-size: 7rem;
    line-height: .4;
    color: #743d91;
}

.quote h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 1.15;
}

.quote p {
    margin-top: 30px;
    color: #927f9d;
    font-family: 'Montserrat', sans-serif;
    font-size: .65rem;
    letter-spacing: 3px;
}

/* =========================
   FINAL SECTION
========================= */

.final {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    z-index: 2;
    padding: 80px 20px;
}

.final-inner {
    max-width: 800px;
}

.final h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 400;
}

.final h2 span {
    color: #a965cf;
}

.final p {
    font-size: 1.35rem;
    line-height: 1.7;
    color: #ad9bb7;
    margin: 30px auto;
    max-width: 600px;
}

.final-line {
    width: 100px;
    height: 1px;
    background: #8e55a9;
    margin: 40px auto;
}

/* =========================
   FOOTER
========================= */

footer {
    position: relative;
    z-index: 2;
    padding: 35px;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,.05);
    color: #66536d;
    font-family: 'Montserrat', sans-serif;
    font-size: .6rem;
    letter-spacing: 3px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px) {

    nav {
        padding: 20px;
    }

    nav .links {
        display: none;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero-description {
        font-size: 1.15rem;
    }

    .poem {
        width: 310px;
        min-height: 480px;
        padding: 40px 30px;
    }

    .poem h3 {
        font-size: 1.8rem;
    }

    .poem p {
        font-size: 1.15rem;
    }

    .author {
        left: 30px;
    }
}
</style>
